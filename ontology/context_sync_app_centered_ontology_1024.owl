    <rdfs:comment xml:lang="ko">조용한 입장 전환 — 동일 매체가 동일 사안의 논조를 설명 없이 바꾸는 프레임</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#Outlet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">언론사 또는 발행 주체</rdfs:label>
  </rdf:Description>

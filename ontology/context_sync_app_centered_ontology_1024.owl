<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns="http://www.context-sync.com/ontology/news-app#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_S03">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#StructuralRuleSchema"/>
    <rdfs:label>S03 ContextOmission schema</rdfs:label>
    <externalRuleId>S03</externalRuleId>
    <descriptionKo xml:lang="ko">표면 명제는 맞지만 필수 맥락을 생략해 결론을 왜곡하는 경우를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_ContextOmission"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_PolicyDebate"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_ContextCompleteness"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_context_omission"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_structural"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.82</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.79</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.64</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_S03"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#verdict_deviated">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Verdict"/>
    <rdfs:label xml:lang="ko">기준 이탈</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#frame_CrisisInflation">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Frame"/>
    <rdfs:label>CrisisInflation</rdfs:label>
    <rdfs:comment xml:lang="ko">위기 부풀리기 — 사안의 위험도를 실제보다 과대하게 묘사하여 공포심을 유발하는 프레임</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#ctx_CorporateScandal">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Topic"/>
    <rdfs:label>CorporateScandal</rdfs:label>
    <rdfs:comment xml:lang="ko">기업 스캔들 — 기업의 비리, 부패, 회계 부정 등과 관련된 주제</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#ctx_Climate">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Topic"/>
    <rdfs:label>Climate</rdfs:label>
    <rdfs:comment xml:lang="ko">기후/환경 — 기후 변화, 환경 정책, 에너지 전환 관련 주제</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#sig_M01">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:label>M01 detection signature</rdfs:label>
    <signaturePrompt xml:lang="ko">근거 수준이 다른 주장을 동등한 양측 의견처럼 병렬 배치하는 허위 균형을 감지한다.</signaturePrompt>
    <positiveCue xml:lang="ko">전문적 합의와 소수 견해의 동등 배치, 근거 수준 차이 생략, 단순 찬반 구도화</positiveCue>
    <negativeIndicator xml:lang="ko">각 입장의 근거 수준과 대표성을 구분함, 합의된 사실과 소수 견해를 분리함</negativeIndicator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#externalRuleId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#RuleSchema"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">외부 규칙 ID</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_T03">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#TemporalRuleSchema"/>
    <rdfs:label>T03 RetroactiveReframing schema</rdfs:label>
    <externalRuleId>T03</externalRuleId>
    <descriptionKo xml:lang="ko">과거 사건의 의미를 현재 논조에 맞게 소급 재구성하는 경우를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_RetroactiveReframing"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_Judiciary"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_ContextCompleteness"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_temporal_shift"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_temporal"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.82</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.8</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.63</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_T03"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Context-Sync News App-Centered Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">Protege-compatible OWL skeleton for a news tone/coherence application. OWL stores the stable symbolic vocabulary and schema-level anchors; the 800 practical detection rules live in an external JSON ruleset consumed by the application rule engine.</rdfs:comment>
    <version>app-centered-v2.0-owl-expanded</version>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_T04">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#TemporalRuleSchema"/>
    <rdfs:label>T04 SelectiveMemory schema</rdfs:label>
    <externalRuleId>T04</externalRuleId>
    <descriptionKo xml:lang="ko">유리한 과거 보도만 기억하고 불리한 과거 기준을 생략하는 경우를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_SelectiveMemory"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_Election"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_ContextCompleteness"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_temporal_shift"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_temporal"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.78</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.81</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.61</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_T04"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_S06">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#StructuralRuleSchema"/>
    <rdfs:label>S06 EmotionalAppeal schema</rdfs:label>
    <externalRuleId>S06</externalRuleId>
    <descriptionKo xml:lang="ko">감정적 단서를 통해 검증보다 반응을 우선시키는 구조를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_EmotionalAppeal"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_WarSecurity"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_FrameAccountability"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_frame_effect"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_structural"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.79</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.82</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.52</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_S06"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#dim_frame_effect">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#EvaluationDimension"/>
    <rdfs:label xml:lang="ko">프레임 효과 왜곡도</rdfs:label>
    <thresholdLow rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35</thresholdLow>
    <thresholdMedium rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">64</thresholdMedium>
    <thresholdHigh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">85</thresholdHigh>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#constrainsFrame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#RuleSchema"/>
    <rdfs:range rdf:resource="http://www.context-sync.com/ontology/news-app#Frame"/>
    <rdfs:label xml:lang="ko">규칙이 제약하거나 감지하는 프레임</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#llmPromptRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#OntologyAnchor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">LLM 프롬프트에서의 역할</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#appFieldName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#OntologyAnchor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">앱 데이터 모델 필드명</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_S04">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#StructuralRuleSchema"/>
    <rdfs:label>S04 LogicalFallacy schema</rdfs:label>
    <externalRuleId>S04</externalRuleId>
    <descriptionKo xml:lang="ko">원인과 결과, 상관과 인과를 혼동하는 구조를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_LogicalFallacy"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_Diplomacy"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_FrameAccountability"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_frame_effect"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_structural"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.76</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.74</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.58</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_S04"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#requiresContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#RuleSchema"/>
    <rdfs:range rdf:resource="http://www.context-sync.com/ontology/news-app#Topic"/>
    <rdfs:label xml:lang="ko">규칙이 요구하는 주제 맥락</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#thresholdLow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#EvaluationDimension"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">낮음 임계값</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_M03">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#MetacognitiveRuleSchema"/>
    <rdfs:label>M03 InstitutionalDistrust schema</rdfs:label>
    <externalRuleId>M03</externalRuleId>
    <descriptionKo xml:lang="ko">제도 불신을 정당한 비판과 구분하지 않고 증폭하는 경우를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_InstitutionalDistrust"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_Judiciary"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_FrameAccountability"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_frame_effect"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_metacognitive"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.81</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.79</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.56</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_M03"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#positiveCue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">탐지 양성 단서</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#ctx_TechnologyAI">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Topic"/>
    <rdfs:label>TechnologyAI</rdfs:label>
    <rdfs:comment xml:lang="ko">기술/AI — 인공지능, 디지털 기술, 플랫폼 규제 관련 주제</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_M02">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#MetacognitiveRuleSchema"/>
    <rdfs:label>M02 PartisanBias schema</rdfs:label>
    <externalRuleId>M02</externalRuleId>
    <descriptionKo xml:lang="ko">동일한 행위를 진영별로 다르게 평가하는 기준 비대칭을 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_PartisanBias"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_Election"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_FrameAccountability"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_frame_effect"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_metacognitive"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.85</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.84</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.57</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_M02"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_S01">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#StructuralRuleSchema"/>
    <rdfs:label>S01 UnverifiedClaim schema</rdfs:label>
    <externalRuleId>S01</externalRuleId>
    <descriptionKo xml:lang="ko">검증되지 않은 주장을 사실처럼 배치하는 구조를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_UnverifiedClaim"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_PublicHealth"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_EvidenceTransparency"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_evidence_quality"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_structural"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.86</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.83</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.65</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_S01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#thresholdMedium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#EvaluationDimension"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">중간 임계값</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#engine_context_sync_rule_engine">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#RuleEngine"/>
    <rdfs:label xml:lang="en">Context-Sync Rule Engine</rdfs:label>
    <evaluationFormula xml:lang="en">final_distortion = 0.34*temporal_shift + 0.24*frame_effect + 0.18*context_omission + 0.14*consensus_deviation + 0.10*evidence_quality; verdict thresholds: &lt;35 aligned, 35-64 caution, &gt;=65 deviated</evaluationFormula>
    <producesVerdict rdf:resource="http://www.context-sync.com/ontology/news-app#verdict_aligned"/>
    <producesVerdict rdf:resource="http://www.context-sync.com/ontology/news-app#verdict_caution"/>
    <producesVerdict rdf:resource="http://www.context-sync.com/ontology/news-app#verdict_deviated"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#ruleCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#ExternalRuleDataset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">규칙 수</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#dim_temporal_shift">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#EvaluationDimension"/>
    <rdfs:label xml:lang="ko">과거-현재 논조 이동 강도</rdfs:label>
    <thresholdLow rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35</thresholdLow>
    <thresholdMedium rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">65</thresholdMedium>
    <thresholdHigh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">82</thresholdHigh>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_M06">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#MetacognitiveRuleSchema"/>
    <rdfs:label>M06 PreemptiveDiscrediting schema</rdfs:label>
    <externalRuleId>M06</externalRuleId>
    <descriptionKo xml:lang="ko">상대 주장을 검토하기 전에 동기/정체성을 문제 삼아 무력화하는 경우를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_PreemptiveDiscrediting"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_PolicyDebate"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_PluralPublicReason"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_frame_effect"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_metacognitive"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.8</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.81</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.54</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_M06"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#Frame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">기사의 논조가 작동시키는 프레임</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.context-sync.com/ontology/news-app#OntologyAnchor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#dim_consensus_deviation">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#EvaluationDimension"/>
    <rdfs:label xml:lang="ko">사회적 기준층 이탈도</rdfs:label>
    <thresholdLow rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35</thresholdLow>
    <thresholdMedium rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">65</thresholdMedium>
    <thresholdHigh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">82</thresholdHigh>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#OntologyAnchor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">RAG가 검색해 LLM에 제공하는 기준 항목</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#sig_S05">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:label>S05 detection signature</rdfs:label>
    <signaturePrompt xml:lang="ko">특정 사례를 과표집해 집단지성의 오류를 유도하는 경우를 감지한다. 과거 기사, 현재 기사, 누락된 전환 설명, 예외 사유를 분리해 판단한다.</signaturePrompt>
    <positiveCue xml:lang="ko">동일 사안 반복 보도, 평가 기준 변화, 선택적 사례 전면화, 설명 없는 가치 이동</positiveCue>
    <negativeIndicator xml:lang="ko">새로운 증거, 명시적 정정, 조건 변화의 충분한 설명, 반론의 균형 있는 제시</negativeIndicator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#frame_FalseBalance">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Frame"/>
    <rdfs:label>FalseBalance</rdfs:label>
    <rdfs:comment xml:lang="ko">허위 균형(양비론) — 근거 수준이 비대칭인 양측을 동등한 것처럼 병렬 배치하는 프레임</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#producesVerdict">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#RuleEngine"/>
    <rdfs:range rdf:resource="http://www.context-sync.com/ontology/news-app#Verdict"/>
    <rdfs:label xml:lang="ko">평가 엔진이 생성하는 최종 판정</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#containsArticle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#ArticleSeries"/>
    <rdfs:range rdf:resource="http://www.context-sync.com/ontology/news-app#Article"/>
    <rdfs:label xml:lang="ko">시리즈가 포함하는 기사</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#sig_M06">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:label>M06 detection signature</rdfs:label>
    <signaturePrompt xml:lang="ko">상대 주장을 검토하기 전에 발화자의 동기·정체성·소속을 문제 삼아 주장을 무력화하는 경우를 감지한다.</signaturePrompt>
    <positiveCue xml:lang="ko">발화자 동기 선제 공격, 소속·정체성 중심 낙인, 주장 내용 검토 생략</positiveCue>
    <negativeIndicator xml:lang="ko">상대 주장의 핵심 논거를 먼저 요약함, 이해관계와 사실 검증을 분리함</negativeIndicator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#RuleSchema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">외부 앱 규칙의 상위 스키마</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.context-sync.com/ontology/news-app#OntologyAnchor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#hasFrame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#NewsArtifact"/>
    <rdfs:range rdf:resource="http://www.context-sync.com/ontology/news-app#Frame"/>
    <rdfs:label xml:lang="ko">기사/시리즈가 작동시키는 프레임</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#suppliedByDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#RuleSchema"/>
    <rdfs:range rdf:resource="http://www.context-sync.com/ontology/news-app#ExternalRuleDataset"/>
    <rdfs:label xml:lang="ko">해당 스키마의 실제 규칙이 들어있는 외부 데이터셋</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#sig_T03">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:label>T03 detection signature</rdfs:label>
    <signaturePrompt xml:lang="ko">과거 사건의 의미를 현재 논조에 맞게 소급 재구성하는 경우를 감지한다. 과거 기사, 현재 기사, 누락된 전환 설명, 예외 사유를 분리해 판단한다.</signaturePrompt>
    <positiveCue xml:lang="ko">동일 사안 반복 보도, 평가 기준 변화, 선택적 사례 전면화, 설명 없는 가치 이동</positiveCue>
    <negativeIndicator xml:lang="ko">새로운 증거, 명시적 정정, 조건 변화의 충분한 설명, 반론의 균형 있는 제시</negativeIndicator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#frame_ResponsibilityShift">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Frame"/>
    <rdfs:label>ResponsibilityShift</rdfs:label>
    <rdfs:comment xml:lang="ko">책임 전가 — 사건의 본질적 책임 주체를 가리고 제3자에게 책임을 떠넘기는 프레임</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_M04">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#MetacognitiveRuleSchema"/>
    <rdfs:label>M04 VictimBlaming schema</rdfs:label>
    <externalRuleId>M04</externalRuleId>
    <descriptionKo xml:lang="ko">원인 귀속과 대응 책임을 혼동해 피해자에게 책임을 전가하는 경우를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_VictimBlaming"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_GenderConflict"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_ResponsibilitySeparation"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_frame_effect"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_metacognitive"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.89</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.87</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.53</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_M04"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#sig_T02">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:label>T02 detection signature</rdfs:label>
    <signaturePrompt xml:lang="ko">정책 평가 기준이 시점별로 바뀌었으나 평가 축 변화가 설명되지 않는 경우를 감지한다. 과거 기사, 현재 기사, 누락된 전환 설명, 예외 사유를 분리해 판단한다.</signaturePrompt>
    <positiveCue xml:lang="ko">동일 사안 반복 보도, 평가 기준 변화, 선택적 사례 전면화, 설명 없는 가치 이동</positiveCue>
    <negativeIndicator xml:lang="ko">새로운 증거, 명시적 정정, 조건 변화의 충분한 설명, 반론의 균형 있는 제시</negativeIndicator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#riskWeightDefault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>

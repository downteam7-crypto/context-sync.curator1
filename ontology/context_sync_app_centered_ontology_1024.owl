    <rdfs:label xml:lang="ko">메타인지/책임 위치 기준층</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#ExternalRuleDataset"/>

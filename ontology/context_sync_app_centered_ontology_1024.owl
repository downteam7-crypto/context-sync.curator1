    <externalRuleFile>news_rules_1024.json</externalRuleFile>
    <ruleCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1024</ruleCount>
    <version>2.0.0-owl-expanded</version>
    <descriptionKo xml:lang="ko">evidence_quality를 포함한 5차원 평가식과 OWL 확장 프레임 M03/M05/M06, M02 보강분을 반영한 1024개 외부 JSON 룰셋.</descriptionKo>
  </rdf:Description>

    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_StanceConsistency"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_temporal_shift"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_temporal"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.92</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.88</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.72</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_T01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#DetectionSignature">

    <rdfs:label>CherryPicking</rdfs:label>
    <rdfs:comment xml:lang="ko">체리피킹(편향적 발췌) — 전체 증거 중 주장에 유리한 일부만 선택적으로 제시하는 프레임</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#descriptionKo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>

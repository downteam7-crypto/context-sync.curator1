    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Topic"/>
    <rdfs:label>GenderConflict</rdfs:label>
    <rdfs:comment xml:lang="ko">젠더 갈등 — 성별 갈등, 성범죄, 젠더 정책 관련 주제</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#ScoreComponent">

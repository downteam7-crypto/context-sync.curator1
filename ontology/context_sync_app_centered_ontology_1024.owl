    <thresholdHigh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">80</thresholdHigh>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#anchoredByValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#RuleSchema"/>
    <rdfs:range rdf:resource="http://www.context-sync.com/ontology/news-app#ValueAnchor"/>
    <rdfs:label xml:lang="ko">규칙이 참조하는 가치 기준</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#comparesAgainst">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#Article"/>
    <rdfs:range rdf:resource="http://www.context-sync.com/ontology/news-app#Article"/>
    <rdfs:label xml:lang="ko">시계열 정합성 비교 대상</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#val_StanceConsistency">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#ValueAnchor"/>
    <rdfs:label xml:lang="en">StanceConsistency</rdfs:label>
    <descriptionKo xml:lang="ko">같은 매체가 같은 사안에 대해 논조를 바꿀 때 설명 책임을 요구하는 기준</descriptionKo>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_social_meaning_proxy"/>
    <calibratesDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_temporal_shift"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#sig_S03">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:label>S03 detection signature</rdfs:label>
    <signaturePrompt xml:lang="ko">표면 명제는 맞지만 필수 맥락을 생략해 결론을 왜곡하는 경우를 감지한다. 과거 기사, 현재 기사, 누락된 전환 설명, 예외 사유를 분리해 판단한다.</signaturePrompt>
    <positiveCue xml:lang="ko">동일 사안 반복 보도, 평가 기준 변화, 선택적 사례 전면화, 설명 없는 가치 이동</positiveCue>
    <negativeIndicator xml:lang="ko">새로운 증거, 명시적 정정, 조건 변화의 충분한 설명, 반론의 균형 있는 제시</negativeIndicator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#distortionWeightDefault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#RuleSchema"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">기본 왜곡 가중치</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#sig_M04">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:label>M04 detection signature</rdfs:label>
    <signaturePrompt xml:lang="ko">원인 귀속과 대응 책임을 혼동해 피해자에게 책임을 전가하는 경우를 감지한다. 과거 기사, 현재 기사, 누락된 전환 설명, 예외 사유를 분리해 판단한다.</signaturePrompt>
    <positiveCue xml:lang="ko">동일 사안 반복 보도, 평가 기준 변화, 선택적 사례 전면화, 설명 없는 가치 이동</positiveCue>
    <negativeIndicator xml:lang="ko">새로운 증거, 명시적 정정, 조건 변화의 충분한 설명, 반론의 균형 있는 제시</negativeIndicator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#frame_InstitutionalDistrust">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Frame"/>
    <rdfs:label>InstitutionalDistrust</rdfs:label>
    <rdfs:comment xml:lang="ko">제도적 불신 — 구체적 근거 없이 제도 자체에 대한 불신을 조장하는 프레임</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#frame_FairnessDiscourse">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Frame"/>
    <rdfs:label>FairnessDiscourse</rdfs:label>
    <rdfs:comment xml:lang="ko">공정성 담론 — 공정성을 표면적으로 내세우면서 실제로는 특정 방향을 정당화하는 프레임</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#Article">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">단일 뉴스 기사</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.context-sync.com/ontology/news-app#NewsArtifact"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_T05">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#TemporalRuleSchema"/>
    <rdfs:label>T05 HistoricalAmnesia schema</rdfs:label>
    <externalRuleId>T05</externalRuleId>
    <descriptionKo xml:lang="ko">역사적 맥락이나 선행 조건을 삭제해 현재 판단만 절대화하는 경우를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_HistoricalAmnesia"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_WarSecurity"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_StanceConsistency"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_temporal_shift"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_temporal"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.8</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.77</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.59</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_T05"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#ctx_Election">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Topic"/>
    <rdfs:label>Election</rdfs:label>
    <rdfs:comment xml:lang="ko">선거 — 선거 캠페인, 후보자 평가, 투표 관련 주제</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#signaturePrompt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">LLM에 주입할 탐지 설명</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#sig_S01">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:label>S01 detection signature</rdfs:label>
    <signaturePrompt xml:lang="ko">검증되지 않은 주장을 사실처럼 배치하는 구조를 감지한다. 출처, 검증 절차, 사실과 추정의 구분, 익명 인용의 역할을 분리해 판단한다.</signaturePrompt>
    <positiveCue xml:lang="ko">출처 불명 주장, 익명 관계자 발언의 사실화, 검증 절차 생략, 의혹 반복</positiveCue>
    <negativeIndicator xml:lang="ko">출처와 검증 절차가 명시됨, 사실과 추정을 구분함, 반론과 근거 수준을 분리함</negativeIndicator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_M05">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#MetacognitiveRuleSchema"/>
    <rdfs:label>M05 ResponsibilityShift schema</rdfs:label>
    <externalRuleId>M05</externalRuleId>
    <descriptionKo xml:lang="ko">책임 주체를 구조에서 개인 또는 주변부로 이동시키는 경우를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_ResponsibilityShift"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_CorporateScandal"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_ResponsibilitySeparation"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_consensus_deviation"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_metacognitive"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.84</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.83</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.55</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_M05"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#hasDetectionSignature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#RuleSchema"/>
    <rdfs:range rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:label xml:lang="ko">규칙을 LLM/RAG에 설명하는 탐지 시그니처</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#calibratesDimension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#ValueAnchor"/>
    <rdfs:range rdf:resource="http://www.context-sync.com/ontology/news-app#EvaluationDimension"/>
    <rdfs:label xml:lang="ko">가치 기준이 보정하는 평가 차원</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_S05">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#StructuralRuleSchema"/>
    <rdfs:label>S05 OverSampling schema</rdfs:label>
    <externalRuleId>S05</externalRuleId>
    <descriptionKo xml:lang="ko">특정 사례를 과표집해 집단지성의 오류를 유도하는 경우를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_OverSampling"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_GenderConflict"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_PluralPublicReason"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_frame_effect"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_structural"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.88</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.86</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.55</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_S05"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#Verdict">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">최종 판정 범주</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#hasTopic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.context-sync.com/ontology/news-app#NewsArtifact"/>
    <rdfs:range rdf:resource="http://www.context-sync.com/ontology/news-app#Topic"/>
    <rdfs:label xml:lang="ko">기사/시리즈를 주제와 연결</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_S02">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#StructuralRuleSchema"/>
    <rdfs:label>S02 CherryPicking schema</rdfs:label>
    <externalRuleId>S02</externalRuleId>
    <descriptionKo xml:lang="ko">전체 분포 대신 일부 사례만 전면화하는 구조를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_CherryPicking"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_CorporateScandal"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_ContextCompleteness"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_context_omission"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_structural"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.83</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.82</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_S02"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#sig_M03">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:label>M03 detection signature</rdfs:label>
    <signaturePrompt xml:lang="ko">정당한 제도 비판과 검증 없는 제도 불신 증폭을 구분해 감지한다. 개별 사건과 제도 전체 일반화의 연결 근거를 분리해 판단한다.</signaturePrompt>
    <positiveCue xml:lang="ko">제도 전체에 대한 단정적 불신, 단일 사건의 제도 전체 일반화, 절차적 해명 생략</positiveCue>
    <negativeIndicator xml:lang="ko">비판 범위가 구체적으로 한정됨, 제도 내부 절차와 견제 장치를 설명함</negativeIndicator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#sig_S04">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#DetectionSignature"/>
    <rdfs:label>S04 detection signature</rdfs:label>
    <signaturePrompt xml:lang="ko">원인과 결과, 상관과 인과, 일부 사례와 전체 결론을 혼동하는 논리 구조를 감지한다.</signaturePrompt>
    <positiveCue xml:lang="ko">인과 비약, 허위 이분법, 상관관계의 인과화, 일부 사례의 전체화</positiveCue>
    <negativeIndicator xml:lang="ko">인과 근거가 명시됨, 대안 설명을 검토함, 상관과 인과를 구분함</negativeIndicator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#ValueAnchor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">흔들리지 않는 기준층으로 쓰는 가치/정합성 기준</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.context-sync.com/ontology/news-app#OntologyAnchor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#frame_ConflictAmplification">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Frame"/>
    <rdfs:label>ConflictAmplification</rdfs:label>
    <rdfs:comment xml:lang="ko">갈등 증폭 — 사안의 대립 구도를 실제보다 과장하여 긴장감을 높이는 프레임</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#frame_PartisanBias">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Frame"/>
    <rdfs:label>PartisanBias</rdfs:label>
    <rdfs:comment xml:lang="ko">정파적 편향 — 동일 행위를 진영에 따라 다른 기준으로 평가하는 프레임</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#dim_evidence_quality">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#EvaluationDimension"/>
    <rdfs:label xml:lang="ko">근거 투명성 부족</rdfs:label>
    <thresholdLow rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">40</thresholdLow>
    <thresholdMedium rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">70</thresholdMedium>
    <thresholdHigh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">90</thresholdHigh>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#val_FrameAccountability">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#ValueAnchor"/>
    <rdfs:label xml:lang="en">FrameAccountability</rdfs:label>
    <descriptionKo xml:lang="ko">문장이 만들어내는 실제 사회적 프레임 효과까지 평가해야 한다는 기준</descriptionKo>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_social_meaning_proxy"/>
    <calibratesDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_frame_effect"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#val_ContextCompleteness">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#ValueAnchor"/>
    <rdfs:label xml:lang="en">ContextCompleteness</rdfs:label>
    <descriptionKo xml:lang="ko">표면 사실이 전체 맥락을 과도하게 생략하지 않아야 한다는 기준</descriptionKo>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_social_meaning_proxy"/>
    <calibratesDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_context_omission"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#val_ResponsibilitySeparation">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#ValueAnchor"/>
    <rdfs:label xml:lang="en">ResponsibilitySeparation</rdfs:label>
    <descriptionKo xml:lang="ko">잘못의 원인 귀속과 대응 책임을 분리해 평가하는 기준</descriptionKo>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_social_meaning_proxy"/>
    <calibratesDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_frame_effect"/>
    <calibratesDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_consensus_deviation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#ctx_LocalPolitics">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#Topic"/>
    <rdfs:label>LocalPolitics</rdfs:label>
    <rdfs:comment xml:lang="ko">지방정치 — 지방자치, 지역 의회, 지방선거 관련 주제</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#schema_M01">
    <rdf:type rdf:resource="http://www.context-sync.com/ontology/news-app#MetacognitiveRuleSchema"/>
    <rdfs:label>M01 FalseBalance schema</rdfs:label>
    <externalRuleId>M01</externalRuleId>
    <descriptionKo xml:lang="ko">근거 수준이 다른 주장을 동등한 양측 의견처럼 배치하는 경우를 감지한다.</descriptionKo>
    <constrainsFrame rdf:resource="http://www.context-sync.com/ontology/news-app#frame_FalseBalance"/>
    <requiresContext rdf:resource="http://www.context-sync.com/ontology/news-app#ctx_PublicHealth"/>
    <anchoredByValue rdf:resource="http://www.context-sync.com/ontology/news-app#val_PluralPublicReason"/>
    <measuresDimension rdf:resource="http://www.context-sync.com/ontology/news-app#dim_consensus_deviation"/>
    <suppliedByDataset rdf:resource="http://www.context-sync.com/ontology/news-app#dataset_news_rules_1024"/>
    <belongsToLayer rdf:resource="http://www.context-sync.com/ontology/news-app#layer_metacognitive"/>
    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.78</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.75</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.58</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_M01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.context-sync.com/ontology/news-app#TemporalRuleSchema">

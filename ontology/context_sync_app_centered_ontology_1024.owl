    <riskWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.87</riskWeightDefault>
    <distortionWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.84</distortionWeightDefault>
    <consensusWeightDefault rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.68</consensusWeightDefault>
    <hasDetectionSignature rdf:resource="http://www.context-sync.com/ontology/news-app#sig_T02"/>
